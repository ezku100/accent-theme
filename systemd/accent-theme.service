[Unit]
Description=Genera la paleta global de tema desde AccentColor de KDE
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/accent-theme watch
Restart=always
RestartSec=2

[Install]
WantedBy=default.target
